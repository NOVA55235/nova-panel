# Nova Panel — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy to .env before running:
#   cp .env.docker .env
#
# Then run:
#   docker compose up -d
# ──────────────────────────────────────────────────────────────

# Database password — change to something strong
POSTGRES_PASSWORD=changeme_strong_password

# JWT signing secret — MUST be a long random string
# Generate: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# First-run admin account (only used if database has no users yet)
ADMIN_EMAIL=admin@gamepanel.io
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# Docker image to use (change after pushing to Docker Hub)
# Example: DOCKER_IMAGE=lordnova98/nova-panel:latest
DOCKER_IMAGE=nova-panel:latest
